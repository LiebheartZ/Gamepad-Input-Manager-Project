<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <InformationalVersion>0.3.0</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>GDM</RootNamespace>
    <AssemblyName>GDM</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>cover.ico</ApplicationIcon>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Sayers.SDL2.Core" Version="1.0.11" />
    <Reference Include="HIDMaestro.Core">
      <HintPath>ThirdParty\HIDMaestro\2.1.0\HIDMaestro.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Resource Include="cover.ico" />
    <None Update="ThirdParty\HIDMaestro\2.1.0\LICENSE"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="Licenses\HIDMaestro\LICENSE" />
    <None Update="ThirdParty\HIDMaestro\2.1.0\THIRD-PARTY-NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="Licenses\HIDMaestro\THIRD-PARTY-NOTICES.txt" />
    <None Include="ThirdParty\SDL2\2.32.10\README-SDL.txt"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="Licenses\SDL2\README-SDL.txt" />
  </ItemGroup>
  <Target Name="CopyUpdatedSdlRuntime" AfterTargets="CopyFilesToOutputDirectory">
    <Copy SourceFiles="ThirdParty\SDL2\2.32.10\SDL2.dll"
          DestinationFiles="$(OutputPath)SDL2.dll"
          SkipUnchangedFiles="true" />
  </Target>
</Project>

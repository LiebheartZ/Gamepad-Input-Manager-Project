                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Avisos toast de Windows al conectar o desconectar mandos, iniciar o detener la salida virtual y otros eventos. «Solo con GDM visible» muestra los avisos únicamente cuando la ventana de GDM está visible."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,14,0,5"
                                           FontSize="12"
                                           Text="Intervalo entre notificaciones (segundos)" />
                                <TextBox Width="100"
                                         HorizontalAlignment="Left"
                                         Text="{Binding Settings.NotificationQueueIntervalSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Si varios eventos coinciden, las notificaciones se muestran en cola, una cada tantos segundos (1–60, por defecto 3)."
                                           TextWrapping="Wrap" />
                                <CheckBox Margin="0,14,0,0"
                                          VerticalAlignment="Center"
                                          Content="Repetir la notificación de batería baja mientras siga baja"
                                          IsChecked="{Binding Settings.BatteryNotifyRepeatEnabled, Mode=TwoWay}" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Activado: avisa cada minuto mientras la batería siga baja. Desactivado: avisa una sola vez hasta que la batería se recupere o se reinicie GDM."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,14,0,5"
                                           FontSize="12"
                                           Text="Eventos con notificación" />
                                <ItemsControl ItemsSource="{Binding Settings.NotificationEventOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Margin="0,2,0,2"
                                                      Content="{Binding Label}"
                                                      FontSize="12"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Desmarca un evento para que no aparezca su notificación. Los cambios se guardan al instante."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,18,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="El idioma disponible actualmente es Español."
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding Settings.IsControllersCategory, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Configuración de mandos" />
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Guarda mandos desde la pestaña Mandos. Configura inicio automático, perfiles, remapeo desde Perfiles."
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,14,0,5"
                                           FontSize="12"
                                           Text="Tipo de mando virtual predeterminado" />
                                <ComboBox Width="220"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding Settings.VirtualGamepadTypeOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding Settings.DefaultVirtualGamepadType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="«Automático» elige DualShock 4 para mandos PlayStation y Xbox 360 para Xbox; si no se detecta el fabricante usa Xbox 360. Los perfiles pueden anularlo con su propio tipo."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,12,0,5"
                                           FontSize="12"
                                           Text="Perfil HIDMaestro para Xbox 360" />
                                <ComboBox Width="220"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding Settings.Xbox360VariantOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding Settings.Xbox360ProfileVariant, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Perfil que HIDMaestro usa para crear el mando virtual Xbox 360. Se aplica al iniciar o reiniciar cualquier salida Xbox 360, incluidas las de perfiles que usan ese tipo."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,12,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="La vibración y el movimiento (acelerómetro/giróscopo, solo DualShock 4) se configuran por mando en Perfiles > Otros."
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding Settings.IsDependenciesCategory, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Dependencias" />
                                <TextBlock Margin="0,12,0,0"
                                           Text=".NET 10 Desktop Runtime x64 — requerido para ejecutar GDM." />
                                <TextBlock Margin="0,8,0,0"
                                           Text="SDL2 — incluido con GDM para detectar mandos y leer sus entradas." />
                                <TextBlock Margin="0,8,0,0"
                                           Text="HIDMaestro — incluido; instala su controlador al iniciar una salida virtual." />
                                <TextBlock Margin="0,8,0,0"
                                           Text="HidHide — controlador opcional, se instala por separado." />
                            </StackPanel>

                            <StackPanel Visibility="{Binding Settings.IsAboutCategory, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Gamepad Device Manager" />
                                <TextBlock Margin="0,12,0,0"
                                           Text="{Binding DataContext.VersionLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="{Binding DataContext.ProgressIdLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="{Binding DataContext.BuildTimestampLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <TextBlock Margin="0,14,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Aplicación portable para Windows."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Creado por LiebheartZ." />
                            </StackPanel>

                            <StackPanel Visibility="{Binding Settings.IsUpdatesCategory, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Actualizaciones" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding Updates.RepositoryDisplay, StringFormat='Repositorio: {0}'}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding Updates.CurrentVersionLabel}"
                                           TextWrapping="Wrap" />
                                <CheckBox Margin="0,14,0,0"
                                          Content="Buscar actualizaciones automáticamente al iniciar GDM"
                                          IsChecked="{Binding Settings.CheckForUpdatesOnStartup, Mode=TwoWay}" />
                                <TextBlock Margin="24,6,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Se aplica al guardar los ajustes. La búsqueda automática es silenciosa; usa el botón para forzar una comprobación."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,12,0,4"
                                           FontSize="12"
                                           Text="Canal de actualizaciones" />
                                <ComboBox Width="220"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding Settings.UpdateChannelOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Settings.UpdateChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="«Estándar» instala la última build publicada del canal. «Nightly» instala el último release publicado en GitHub, incluidas las compilaciones intermedias."
                                           TextWrapping="Wrap" />
                                <Button Margin="0,16,0,0"
                                        HorizontalAlignment="Left"
                                        MinWidth="170"
                                        Padding="14,8"
                                        Command="{Binding Updates.CheckCommand}"
                                        Content="Buscar actualizaciones" />
                                <TextBlock Margin="0,14,0,0"
                                           FontWeight="SemiBold"
                                           Text="{Binding Updates.UpdateStatusLabel}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding Updates.StatusMessage}"
                                           TextWrapping="Wrap" />
                                <ProgressBar Margin="0,10,0,0"
                                             Height="8"
                                             Maximum="100"
                                             Value="{Binding Updates.DownloadProgress, Mode=OneWay}"
                                             Visibility="{Binding Updates.IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                                <Button Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        MinWidth="200"
                                        Padding="14,8"
                                        Command="{Binding Updates.InstallCommand}"
                                        Content="Descargar e instalar"
                                        IsEnabled="{Binding Updates.CanInstall}" />
                                <TextBlock Margin="0,10,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="La actualización descarga el paquete publicado en GitHub, cierra GDM de forma segura y lo reinicia con los archivos nuevos."
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding Settings.IsDebugCategory, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Depuración" />
                                <CheckBox Margin="0,14,0,0"
                                          Content="Mostrar mandos virtuales en todas las pestañas"
                                          IsChecked="{Binding Settings.ShowVirtualGamepadsInAllTabs, Mode=TwoWay}" />
                                <TextBlock Margin="24,6,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Por defecto los mandos virtuales de HIDMaestro solo aparecen en Mandos y Tester, marcados como «Mando virtual». Activa esta opción para verlos también en HidHide y el resto de listas de dispositivos."
                                           TextWrapping="Wrap" />
                                <Button Margin="0,18,0,0"
                                        HorizontalAlignment="Left"
                                        MinWidth="240"
                                        Padding="14,8"
                                        Command="{Binding Updates.ForceInstallLatestCommand}"
                                        Content="Forzar instalación de la última build" />
                                <TextBlock Margin="0,8,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Descarga e instala el último release publicado en GitHub aunque sea la misma build o no supere los criterios del canal. Solo para pruebas; GDM se cerrará y se reiniciará."
                                           TextWrapping="Wrap" />
                                <Button Margin="0,18,0,0"
                                        HorizontalAlignment="Left"
                                        MinWidth="240"
                                        Padding="14,8"
                                        Command="{Binding HidHide.OpenInstallWindowCommand}"
                                        Content="Abrir ventana de instalación de HidHide" />
                                <TextBlock Margin="0,8,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Solo para pruebas: abre la ventana de instalación/descarga de HidHide aunque el driver ya esté instalado."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Margin="0,16,0,0"
                                Orientation="Horizontal">
                        <Button MinWidth="130"
                                Padding="14,8"
                                Command="{Binding Settings.SaveCommand}"
                                Content="{Binding Settings.SaveButtonText}" />
                        <Button MinWidth="150"
                                Margin="10,0,0,0"
                                Padding="14,8"
                                Command="{Binding Settings.RestoreDefaultsCommand}"
                                Content="Restaurar predeterminados" />
                    </StackPanel>
                    <TextBlock Margin="0,16,0,0"
                               FontWeight="SemiBold"
                               Text="{Binding Settings.StatusTitle}" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding Settings.StatusMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,2,0,0"
                            Visibility="{Binding IsBluetoothSection, Converter={StaticResource BoolToVisibility}}">
                    <Border Padding="18"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Dispositivos Bluetooth" />
                                <TextBlock Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding Bluetooth.BluetoothStatusText}" />
                            </StackPanel>
                            <CheckBox Margin="0,14,0,0"
                                      VerticalAlignment="Center"
                                      IsEnabled="{Binding Bluetooth.IsBluetoothAvailable}"
                                      Content="Conectar mandos automáticamente"
                                      IsChecked="{Binding Bluetooth.AutoConnectEnabled, Mode=TwoWay}"
                                      ToolTip="Si un mando entra en modo emparejamiento, GDM lo empareja solo sin abrir los ajustes de Bluetooth de Windows." />
                            <CheckBox Margin="0,8,0,0"
                                      VerticalAlignment="Center"
                                      IsEnabled="{Binding Bluetooth.IsBluetoothAvailable}"
                                      Content="Reintentar emparejamiento cada 5 segundos"
                                      IsChecked="{Binding Bluetooth.AutoPairLoopEnabled, Mode=TwoWay}"
                                      ToolTip="Con la auto-conexión activa: desactivado hace un único intento por detección; activado reintenta cada 5 segundos hasta emparejar o hasta que el mando salga de la lista." />
                            <CheckBox Margin="0,8,0,0"
                                      VerticalAlignment="Center"
                                      IsEnabled="{Binding Bluetooth.IsBluetoothAvailable}"
                                      Content="Mostrar todos los dispositivos"
                                      IsChecked="{Binding Bluetooth.ShowAllDevices, Mode=TwoWay}"
                                      ToolTip="Por defecto solo se muestran mandos. Activa esto para ver cualquier dispositivo Bluetooth detectado." />
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="La detección funciona mientras GDM esté abierto, aunque esté minimizado en la bandeja. Los mandos deben estar en modo emparejamiento para aparecer."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,12,0,0"
                            Padding="16"
                            Background="{DynamicResource PanelRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding Bluetooth.ShowBluetoothUnavailable, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="Bluetooth no disponible" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{Binding Bluetooth.UnavailableReasonText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Las funciones de esta pestaña (buscar, emparejar y auto-conexión) no pueden funcionar sin Bluetooth. Conecta o activa el adaptador Bluetooth de Windows y vuelve a esta pestaña."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="0,14,0,0"
                                Orientation="Horizontal">
                        <Button MinWidth="140"
                                Padding="14,8"
                                IsEnabled="{Binding Bluetooth.IsBluetoothAvailable}"
                                Command="{Binding Bluetooth.RefreshCommand}"
                                Content="Buscar dispositivos" />
                        <Button MinWidth="190"
                                Margin="10,0,0,0"
                                Padding="14,8"
                                Command="{Binding Bluetooth.OpenWindowsSettingsCommand}"
                                Content="Abrir Bluetooth de Windows" />
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding Bluetooth.StatusMessage}"
                               TextWrapping="Wrap" />
                    <ItemsControl Margin="0,10,0,0"
                                  ItemsSource="{Binding Bluetooth.Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="14"
                                        Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding Name}" />
                                                <Border Margin="8,0,0,0"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource PanelRaisedBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Visibility="{Binding LooksLikeGamepad, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock FontSize="10"
                                                               Text="Mando probable" />
                                                </Border>
                                                <Border Margin="6,0,0,0"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource PanelRaisedBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4">
                                                    <TextBlock FontSize="10"
                                                               Text="{Binding TransportLabel}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Text="{Binding Address, TargetNullValue=Sin dirección}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Text="{Binding StatusText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Padding="12,5"
                                                    MinWidth="110"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                                    Command="{Binding PairCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding ActionLabel}"
                                                    Visibility="{Binding IsPaired, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <Button Padding="12,5"
                                                    MinWidth="110"
                                                    Margin="8,0,0,0"
                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                                    Command="{Binding UnpairCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding ActionLabel}"
                                                    Visibility="{Binding IsPaired, Converter={StaticResource BoolToVisibility}}" />
                                            <CheckBox Margin="10,0,0,0"
                                                      VerticalAlignment="Center"
                                                      FontSize="11"
                                                      IsChecked="{Binding AutoConnectBlocked, Mode=TwoWay}"
                                                      Content="No conectar automáticamente"
                                                      ToolTip="Marcado: este dispositivo nunca se emparejará solo aunque el auto-emparejamiento esté activado. Sigue pudiendo emparejarse manualmente." />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,10,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding Bluetooth.EmptyMessage}"
                               TextWrapping="Wrap"
                               Visibility="{Binding Bluetooth.ShowEmptyMessage, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <StackPanel Margin="0,2,0,0"
                            Visibility="{Binding IsLogSection, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Margin="0,0,0,4"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Archivo de registro" />
                    <TextBlock Margin="0,0,0,10"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding LogFilePath}" />
                    <Border Padding="12"
                            Background="#111820"
                            BorderBrush="#293543"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ScrollViewer MaxHeight="390"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LogEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,7"
                                                BorderBrush="#293543"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="165" />
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="115" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="#AAB6C4"
                                                           Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                                <TextBlock Grid.Column="1"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Level}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#8CC8FF" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:DiagnosticLogLevel.Warning}">
                                                                    <Setter Property="Foreground" Value="#F3C969" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:DiagnosticLogLevel.Error}">
                                                                    <Setter Property="Foreground" Value="#FF8585" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:DiagnosticLogLevel.Critical}">
                                                                    <Setter Property="Foreground" Value="#FF4F64" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="#8CC8FF"
                                                           Text="{Binding Source}" />
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock FontFamily="Consolas"
                                                               FontSize="11"
                                                               Foreground="#E1E8EF"
                                                               Text="{Binding Message}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontFamily="Consolas"
                                                               FontSize="10"
                                                               Foreground="#AAB6C4"
                                                               Text="{Binding Details}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Este registro contiene errores y eventos de ejecución. Los errores de compilación aparecen en la salida de compilación de VS Code." />
                </StackPanel>

                <StackPanel Visibility="{Binding IsProfilesSection, Converter={StaticResource BoolToVisibility}}">
                    <TabControl ItemsSource="{Binding Profiles.PerfilesTabs}"
                                SelectedItem="{Binding Profiles.SelectedVirtualGamepad, Mode=TwoWay}"
                                Background="Transparent"
                                BorderThickness="0">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding DisplayName}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="10"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{Binding ConnectionStatus}" />
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                <TabControl Margin="0,12,0,0"
                                            Background="Transparent"
                                            BorderThickness="0">
                                    <TabControl.Style>
                                        <Style TargetType="TabControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGlobalPresetEditor}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TabControl.Style>
                                    <TabItem Header="Mando virtual">
                                        <StackPanel Margin="16,14,16,16">
                                            <Border Padding="14"
                                                    Background="{DynamicResource PanelBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding DisplayName}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Text="{Binding ConnectionStatus}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Text="{Binding ProfileName, StringFormat=Perfil: {0}}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="11"

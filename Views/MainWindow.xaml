                                                           FontSize="12"
                                                           Text="Intervalo de movimiento" />
                                                <ComboBox Width="240"
                                                          HorizontalAlignment="Left"
                                                          ItemsSource="{Binding MotionPollIntervalOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding MotionPollIntervalMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,14,0,0"
                                                Padding="18"
                                                Background="{DynamicResource PanelBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Text="Mandos no guardados" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Text="Qué hacer cuando se conecta un mando físico que no tiene ajustes guardados. Nunca se aplica a mandos virtuales."
                                                           TextWrapping="Wrap" />
                                                <ComboBox Width="280"
                                                          HorizontalAlignment="Left"
                                                          Margin="0,10,0,0"
                                                          ItemsSource="{Binding UnsavedDevicesOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding UnsavedDevicesMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Border>
                                                </StackPanel>
                                            </TabItem>
                                        </TabControl>
                                        <StackPanel Margin="0,14,0,0"
                                                    Orientation="Horizontal">
                                            <Button MinWidth="120"
                                                    Padding="14,8"
                                                    Command="{Binding SaveCommand}"
                                                    Content="Guardar ajuste global" />
                                            <TextBlock Margin="12,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Text="Los cambios se aplican a los mandos que usan «Ajuste global»."
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

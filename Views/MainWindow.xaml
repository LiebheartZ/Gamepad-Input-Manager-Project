<Window x:Class="GDM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:GDM.Models"
        xmlns:views="clr-namespace:GDM.Views"
        Title="GDM — Gamepad Device Manager"
        Icon="/cover.ico"
        Width="800"
        Height="600"
        MinWidth="640"
        MinHeight="480"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#183E5C">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image Width="42"
                           Height="42"
                           Source="/cover.ico"
                           Stretch="Uniform" />
                    <TextBlock Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               Text="GDM" />
                    <TextBlock Margin="8,5,0,0"
                               VerticalAlignment="Center"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               Text="Gamepad Device Manager" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Visibility="{Binding IsVirtualGamepadBusy, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Width="90"
                                     Height="5"
                                     VerticalAlignment="Center"
                                     IsIndeterminate="True"
                                     Foreground="#7FD4FF" />
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="#FFD166"
                                   Text="{Binding VirtualGamepadBusyMessage}" />
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right"
                               FontSize="12"
                               Foreground="#C5D5E3"
                               Text="{Binding VersionLabel}" />
                    <TextBlock Margin="0,2,0,0"
                               HorizontalAlignment="Right"
                               FontSize="10"
                               Foreground="#C5D5E3"
                               Text="{Binding ProgressIdLabel}" />
                    <TextBlock Margin="0,2,0,0"
                               HorizontalAlignment="Right"
                               FontSize="10"
                               Foreground="#C5D5E3"
                               Text="{Binding BuildTimestampLabel}" />
                    <StackPanel Margin="0,4,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding BluetoothStatusForeground}"
                                   Text="&#xE701;" />
                        <TextBlock Margin="5,0,0,0"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding BluetoothStatusForeground}"
                                   Text="{Binding BluetoothStatusText}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#183E5C"
                BorderBrush="#2D5877"
                BorderThickness="0,0,0,1">
            <StackPanel Margin="24,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Stretch">
                <Button Command="{Binding NavigateCommand}"
                        CommandParameter="Inicio"
                        Content="Inicio"
                        Style="{StaticResource TopTabButtonStyle}"
                        Tag="Inicio" />
                <Button Command="{Binding NavigateCommand}"
                        CommandParameter="Bluetooth"
                        Content="Bluetooth"
                        Style="{StaticResource TopTabButtonStyle}"
                        Tag="Bluetooth" />
                <Button Command="{Binding NavigateCommand}"
                        CommandParameter="Mandos"
                        Content="Mandos"
                        Style="{StaticResource TopTabButtonStyle}"
                        Tag="Mandos" />
                <Button Command="{Binding NavigateCommand}"
                        CommandParameter="Tester"
                        Content="Tester"
                        Style="{StaticResource TopTabButtonStyle}"
                        Tag="Tester" />
                <Button Command="{Binding NavigateCommand}"
                        CommandParameter="Perfiles"
                        Content="Perfiles"
                        Style="{StaticResource TopTabButtonStyle}"
                        Tag="Perfiles" />
                <Button Command="{Binding NavigateCommand}"
                        CommandParameter="HidHide"
                        Content="HidHide"
                        Style="{StaticResource TopTabButtonStyle}"
                        Tag="HidHide" />
                <Button Command="{Binding NavigateCommand}"
                        CommandParameter="Ajustes"
                        Content="Ajustes"
                        Style="{StaticResource TopTabButtonStyle}"
                        Tag="Ajustes" />
                <Button Command="{Binding NavigateCommand}"
                        CommandParameter="Registro"
                        Content="Registro"
                        Style="{StaticResource TopTabButtonStyle}"
                        Tag="Registro" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2"
                      Background="{DynamicResource WindowBrush}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="48,30" MaxWidth="900">
                <TextBlock Margin="0,0,0,28"
                           FontSize="15"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding SectionDescription}"
                           TextWrapping="Wrap" />

                <Grid Margin="0,0,0,20"
                      Visibility="{Binding IsTesterSection, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Padding="14"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,4"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Mandos conectados" />
                            <TextBlock DockPanel.Dock="Top"
                                       Margin="0,0,0,12"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{Binding Tester.DevicesSummary}" />
                            <TextBlock DockPanel.Dock="Bottom"
                                       Margin="0,12,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="La lista se actualiza automáticamente."
                                       TextWrapping="Wrap" />
                            <Grid>
                                <ListBox ItemsSource="{Binding Tester.Devices}"
                                         SelectedItem="{Binding Tester.SelectedDevice, Mode=TwoWay}"
                                         IsEnabled="{Binding Tester.CanSelectDevice}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         PreviewMouseLeftButtonDown="GamepadListPreviewMouseLeftButtonDown"
                                         PreviewMouseLeftButtonUp="GamepadListPreviewMouseLeftButtonUp"
                                         PreviewMouseWheel="GamepadListPreviewMouseWheel"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,8" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder"
                                                            Padding="{TemplateBinding Padding}"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="5">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder"
                                                                    Property="Background"
                                                                    Value="{DynamicResource SelectionBrush}" />
                                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder"
                                                                    Property="BorderBrush"
                                                                    Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding Name}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontWeight="SemiBold"
                                                       Text="Mando virtual"
                                                       Visibility="{Binding IsVirtualGamepad, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="11"
                                                       Text="{Binding HardwareIdLabel}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Text="Oculto por GDM"
                                                       Visibility="{Binding IsHiddenByGdm, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Margin="4"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="No hay mandos conectados."
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Tester.ShowNoDevices, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Padding="18"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{Binding Tester.HasSelectedDevice, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="{Binding Tester.SelectedDevice.Name}" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="SemiBold"
                                           Text="Mando virtual"
                                           Visibility="{Binding Tester.SelectedDevice.IsVirtualGamepad, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Margin="0,5,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding Tester.SelectedDevice.HardwareIdLabel}" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding Tester.SelectedDevice.DeviceKey}" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding Tester.SelectedDevice.SdlGuid, TargetNullValue=GUID SDL no disponible}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,10,0,0"
                                           FontWeight="SemiBold"
                                           Text="{Binding Tester.InputStatus}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding Tester.SelectedDevice.DevicePath, TargetNullValue=Ruta no disponible}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding Tester.SelectedDevice.SerialNumber, TargetNullValue=Número de serie no disponible}" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding Tester.SelectedDevice.BatteryInfoText}"
                                           Visibility="{Binding Tester.SelectedDevice.HasBatteryInfo, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Firmware: no disponible mediante la API SDL actual." />
                                <TextBlock Margin="0,12,0,4"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="Probar vibración" />
                                <WrapPanel>
                                    <Button MinWidth="110"
                                            Margin="0,0,8,0"
                                            Command="{Binding Tester.RumbleWeakCommand}"
                                            Content="Vibración suave"
                                            ToolTip="Rumble suave durante 600 ms" />
                                    <Button MinWidth="110"
                                            Margin="0,0,8,0"
                                            Command="{Binding Tester.RumbleStrongCommand}"
                                            Content="Vibración fuerte"
                                            ToolTip="Rumble fuerte durante 900 ms" />
                                    <Button MinWidth="90"
                                            Command="{Binding Tester.RumbleStopCommand}"
                                            Content="Detener"
                                            ToolTip="Detiene la vibración del mando" />
                                </WrapPanel>
                                 <TextBlock Margin="0,14,0,4"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="Movimiento" />
                                 <TextBlock FontSize="11"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            Text="{Binding Tester.MotionSensorsText}"
                                            TextWrapping="Wrap" />
                                 <StackPanel Margin="0,8,0,0"
                                             Orientation="Horizontal"
                                             Visibility="{Binding Tester.HasMotionData, Converter={StaticResource BoolToVisibility}}">
                                     <Canvas Width="124" Height="124">
                                         <Border Width="124" Height="124"
                                                 Background="{DynamicResource PanelRaisedBrush}"
                                                 BorderBrush="{DynamicResource SecondaryTextBrush}"
                                                 BorderThickness="1"
                                                 CornerRadius="10" />
                                         <Ellipse Width="14" Height="14"
                                                  Fill="{DynamicResource AccentBrush}"
                                                  Canvas.Left="{Binding Tester.MotionDotLeft}"
                                                  Canvas.Top="{Binding Tester.MotionDotTop}"
                                                  ToolTip="Nivel de inclinación (acelerómetro)" />
                                     </Canvas>
                                     <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                         <TextBlock FontSize="11"
                                                    FontFamily="Consolas"
                                                    Text="{Binding Tester.MotionAccelText}" />
                                         <TextBlock Margin="0,6,0,0"
                                                    FontSize="11"
                                                    FontFamily="Consolas"
                                                    Text="{Binding Tester.MotionGyroText}" />
                                         <TextBlock Margin="0,8,0,0"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                    Text="La burbuja muestra la inclinación del mando."
                                                    TextWrapping="Wrap" />
                                     </StackPanel>
                                 </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Padding="18"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{Binding Tester.HasInputSnapshot, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Entradas en tiempo real" />
                                <TextBlock Margin="0,5,0,12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Los valores cambian al mover sticks o presionar controles." />
                                <Viewbox Width="460"
                                         Height="350"
                                         Margin="0,0,0,12"
                                         HorizontalAlignment="Center"
                                         Stretch="Uniform"
                                         Visibility="{Binding Tester.ShowMappedDiagram, Converter={StaticResource BoolToVisibility}}">
                                    <Canvas Width="460" Height="350">
                                        <Canvas Canvas.Top="8"
                                                Width="460"
                                                Height="330">
                                        <Path Data="M 72,25 C 92,8 125,7 151,16 C 205,34 255,34 309,16 C 335,7 368,8 388,25 C 423,53 447,131 458,229 C 465,284 437,321 398,310 C 374,303 348,268 326,234 C 309,208 291,192 269,190 C 254,188 247,204 230,204 C 213,204 206,188 191,190 C 169,192 151,208 134,234 C 112,268 86,303 62,310 C 23,321 -5,284 2,229 C 13,131 37,53 72,25 Z"
                                              Fill="{DynamicResource PanelRaisedBrush}"
                                              Stroke="{DynamicResource SecondaryTextBrush}"
                                              StrokeThickness="2"
                                              StrokeLineJoin="Round" />
                                        <Border Canvas.Left="92"
                                                Canvas.Top="20"
                                                Width="94"
                                                Height="18"
                                                BorderBrush="{DynamicResource SecondaryTextBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tester.IsLeftShoulderPressed}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ConnectedStatusBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <Border Canvas.Left="274"
                                                Canvas.Top="20"
                                                Width="94"
                                                Height="18"
                                                BorderBrush="{DynamicResource SecondaryTextBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tester.IsRightShoulderPressed}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ConnectedStatusBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <Ellipse Canvas.Left="132"
                                                 Canvas.Top="146"
                                                 Width="80"
                                                 Height="80"
                                                 Stroke="{DynamicResource SecondaryTextBrush}"
                                                 StrokeThickness="2.5">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource PanelBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tester.IsLeftStickPressed}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource ConnectedStatusBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <Ellipse Canvas.Left="248"
                                                 Canvas.Top="146"
                                                 Width="80"
                                                 Height="80"
                                                 Stroke="{DynamicResource SecondaryTextBrush}"
                                                 StrokeThickness="2.5">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource PanelBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tester.IsRightStickPressed}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource ConnectedStatusBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <Ellipse Canvas.Left="140"
                                                 Canvas.Top="154"
                                                 Width="64"
                                                 Height="64"
                                                 Fill="{DynamicResource PanelRaisedBrush}"
                                                 Stroke="{DynamicResource SecondaryTextBrush}"
                                                 StrokeThickness="1.5"
                                                 IsHitTestVisible="False" />
                                        <Ellipse Canvas.Left="256"
                                                 Canvas.Top="154"
                                                 Width="64"
                                                 Height="64"
                                                 Fill="{DynamicResource PanelRaisedBrush}"
                                                 Stroke="{DynamicResource SecondaryTextBrush}"
                                                 StrokeThickness="1.5"
                                                 IsHitTestVisible="False" />
                                        <Ellipse Canvas.Left="{Binding Tester.LeftStickDotLeft}"
                                                 Canvas.Top="{Binding Tester.LeftStickDotTop}"
                                                 Width="12"
                                                 Height="12"
                                                 Fill="{DynamicResource AccentBrush}"
                                                 Stroke="{DynamicResource PanelBrush}"
                                                 StrokeThickness="1"
                                                 IsHitTestVisible="False" />
                                        <Ellipse Canvas.Left="{Binding Tester.RightStickDotLeft}"
                                                 Canvas.Top="{Binding Tester.RightStickDotTop}"
                                                 Width="12"
                                                 Height="12"
                                                 Fill="{DynamicResource AccentBrush}"
                                                 Stroke="{DynamicResource PanelBrush}"
                                                 StrokeThickness="1"
                                                 IsHitTestVisible="False" />
                                        <Border Canvas.Left="92"
                                                Canvas.Top="43"
                                                Width="94"
                                                Height="14"
                                                Background="{DynamicResource PanelBrush}"
                                                BorderBrush="{DynamicResource SecondaryTextBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                ClipToBounds="True" />
                                        <Border Canvas.Left="94"
                                                Canvas.Top="45"
                                                Width="{Binding Tester.LeftTriggerVisualWidth}"
                                                Height="10"
                                                Background="{DynamicResource ConnectedStatusBrush}"
                                                CornerRadius="4"
                                                IsHitTestVisible="False" />
                                        <TextBlock Canvas.Left="98"
                                                   Canvas.Top="44"
                                                   FontSize="8"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Text="L2"
                                                   IsHitTestVisible="False" />
                                        <Border Canvas.Left="274"
                                                Canvas.Top="43"
                                                Width="94"
                                                Height="14"
                                                Background="{DynamicResource PanelBrush}"
                                                BorderBrush="{DynamicResource SecondaryTextBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                ClipToBounds="True" />
                                        <Border Canvas.Left="276"
                                                Canvas.Top="45"
                                                Width="{Binding Tester.RightTriggerVisualWidth}"
                                                Height="10"
                                                Background="{DynamicResource ConnectedStatusBrush}"
                                                CornerRadius="4"
                                                IsHitTestVisible="False" />
                                        <TextBlock Canvas.Left="358"
                                                   Canvas.Top="44"
                                                   FontSize="8"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Text="R2"
                                                   IsHitTestVisible="False" />
                                        <Border Canvas.Left="184"
                                                Canvas.Top="54"
                                                Width="92"
                                                Height="48"
                                                BorderBrush="{DynamicResource SecondaryTextBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="6"
                                                Visibility="{Binding Tester.HasTouchpadOrExtraButton, Converter={StaticResource BoolToVisibility}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tester.IsTouchpadPressed}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ConnectedStatusBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="8"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Text="TOUCH / EXTRA"
                                                       IsHitTestVisible="False" />
                                        </Border>
                                        <Ellipse Width="10"
                                                 Height="10"
                                                 Fill="{DynamicResource AccentBrush}"
                                                 Stroke="{DynamicResource PrimaryTextBrush}"
                                                 StrokeThickness="1"
                                                 Canvas.Left="{Binding Tester.TouchpadFinger0Left}"
                                                 Canvas.Top="{Binding Tester.TouchpadFinger0Top}"
                                                 Visibility="{Binding Tester.TouchpadFinger0Visible, Converter={StaticResource BoolToVisibility}}"
                                                 IsHitTestVisible="False" />
                                        <Ellipse Width="10"
                                                 Height="10"
                                                 Fill="{DynamicResource AccentBrush}"
                                                 Stroke="{DynamicResource PrimaryTextBrush}"
                                                 StrokeThickness="1"
                                                 Canvas.Left="{Binding Tester.TouchpadFinger1Left}"
                                                 Canvas.Top="{Binding Tester.TouchpadFinger1Top}"
                                                 Visibility="{Binding Tester.TouchpadFinger1Visible, Converter={StaticResource BoolToVisibility}}"
                                                 IsHitTestVisible="False" />
                                        <Border Canvas.Left="194"
                                                Canvas.Top="119"
                                                Width="30"
                                                Height="17"
                                                BorderBrush="{DynamicResource SecondaryTextBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tester.IsSelectPressed}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ConnectedStatusBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ConnectedStatusBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       Text="−" />
                                        </Border>
                                        <Border Canvas.Left="236"
                                                Canvas.Top="119"
                                                Width="30"
                                                Height="17"
                                                BorderBrush="{DynamicResource SecondaryTextBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tester.IsStartPressed}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ConnectedStatusBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ConnectedStatusBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       Text="≡" />
                                        </Border>
                                        <Ellipse Canvas.Left="217"
                                                 Canvas.Top="140"
                                                 Width="26"
                                                 Height="26"
                                                 Stroke="{DynamicResource SecondaryTextBrush}"

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Version>292</Version>
    <AssemblyVersion>292.0.0.0</AssemblyVersion>
    <FileVersion>292.0.0.0</FileVersion>
    <InformationalVersion>292</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>GDM</RootNamespace>
    <AssemblyName>GDM</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>cover.ico</ApplicationIcon>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Sayers.SDL2.Core" Version="1.0.11" />
    <Reference Include="HIDMaestro.Core">
      <HintPath>ThirdParty\HIDMaestro\2.1.0\HIDMaestro.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="Otros\**\*.cs" />
    <Compile Remove="Tools\**\*.cs" />
    <None Remove="Tools\**" />
    <Page Remove="Otros\**\*.xaml" />
    <EmbeddedResource Remove="Otros\**" />
    <None Remove="Otros\**" />
    <Resource Include="cover.ico" />
    <None Update="ThirdParty\HIDMaestro\2.1.0\LICENSE" CopyToOutputDirectory="PreserveNewest" TargetPath="Licenses\HIDMaestro\LICENSE" />
    <None Update="ThirdParty\HIDMaestro\2.1.0\THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" TargetPath="Licenses\HIDMaestro\THIRD-PARTY-NOTICES.txt" />
    <None Include="ThirdParty\SDL2\2.32.74\README-SDL.txt" CopyToOutputDirectory="PreserveNewest" TargetPath="Licenses\SDL2\README-SDL.txt" />
  </ItemGroup>
  <Target Name="CopyUpdatedSdlRuntime" AfterTargets="CopyFilesToOutputDirectory">
    <Copy SourceFiles="ThirdParty\SDL2\2.32.74\SDL2.dll" DestinationFiles="$(OutDir)SDL2.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="ThirdParty\SDL2\2.32.74\SDL3.dll" DestinationFiles="$(OutDir)SDL3.dll" SkipUnchangedFiles="true" />
  </Target>
  <!-- dotnet publish recopila los assets nativos del paquete NuGet
       (SDL2 2.0.20) después de CopyFilesToOutputDirectory y los copia al
       PublishDir, pisando el SDL2 2.32.74. Este segundo paso garantiza que
       el runtime correcto quede en la salida publicada. -->
  <Target Name="CopyUpdatedSdlRuntimePublish" AfterTargets="Publish">
    <Copy SourceFiles="ThirdParty\SDL2\2.32.74\SDL2.dll" DestinationFiles="$(PublishDir)SDL2.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="ThirdParty\SDL2\2.32.74\SDL3.dll" DestinationFiles="$(PublishDir)SDL3.dll" SkipUnchangedFiles="true" />
  </Target>
</Project>

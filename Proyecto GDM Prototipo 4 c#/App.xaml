<Application x:Class="GDM.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="WindowBrush" Color="#F4F7FA" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#E6EEF5" />
        <SolidColorBrush x:Key="AccentBrush" Color="#1477D4" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1C2A36" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#627383" />

        <Style x:Key="TopTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D5E2EE" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Margin" Value="2,0,2,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#285574" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding CurrentSection}" Value="Inicio" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Inicio" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource WindowBrush}" />
                    <Setter Property="Foreground" Value="#174F7D" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding CurrentSection}" Value="Mandos" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Mandos" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource WindowBrush}" />
                    <Setter Property="Foreground" Value="#174F7D" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding CurrentSection}" Value="Ajustes" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Ajustes" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource WindowBrush}" />
                    <Setter Property="Foreground" Value="#174F7D" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding CurrentSection}" Value="Registro" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Registro" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource WindowBrush}" />
                    <Setter Property="Foreground" Value="#174F7D" />
                </MultiDataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>

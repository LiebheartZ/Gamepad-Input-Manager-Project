<Window x:Class="GDM.Views.BluetoothPairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:GDM.Models"
        Title="Emparejamiento Bluetooth"
        Width="700"
        Height="500"
        MinWidth="600"
        MinHeight="400"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Text="Emparejamiento Bluetooth LE" />

        <TextBlock Grid.Row="1"
                   Margin="0,8,0,0"
                   FontSize="13"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="Gestiona el emparejamiento de mandos Bluetooth Low Energy. Solo se emparejan automáticamente los dispositivos reconocidos como mandos."
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="2" Margin="0,16,0,0" Orientation="Horizontal">
            <CheckBox Content="Mostrar todos los dispositivos"
                      IsChecked="{Binding ShowAllDevices, Mode=TwoWay}"
                      Margin="0,0,24,0" />
            <CheckBox Content="Conectar automáticamente mandos reconocidos"
                      IsChecked="{Binding EnableAutoConnect, Mode=TwoWay}" />
        </StackPanel>

        <Border Grid.Row="3"
                Margin="0,16,0,0"
                Padding="12"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <ListBox ItemsSource="{Binding FilteredDevices}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding Name}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               Text="{Binding StatusLabel}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               Text="{Binding Id}"
                                                               TextWrapping="Wrap"
                                                               Visibility="Collapsed" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Content="Conectar"
                                                            Command="{Binding DataContext.PairCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="12,6"
                                                            Margin="0,0,8,0"
                                                            Visibility="{Binding CanPair, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button Content="Desemparejar"
                                                            Command="{Binding DataContext.UnpairCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="12,6"
                                                            Visibility="{Binding CanUnpair, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="No hay dispositivos Bluetooth detectados."
                           TextWrapping="Wrap"
                           Visibility="{Binding FilteredDevices.Count, Converter={StaticResource ZeroToVisibility}}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Content="Actualizar"
                    Command="{Binding RefreshCommand}"
                    Padding="20,8"
                    Margin="0,0,12,0" />
            <Button Content="Cerrar"
                    Click="OnCloseClick"
                    Padding="20,8" />
        </StackPanel>
    </Grid>
</Window>

                                        </Border>
                                        <Border Canvas.Left="343"
                                                Canvas.Top="130"
                                                Width="34"
                                                Height="34"
                                                BorderBrush="{DynamicResource SecondaryTextBrush}"
                                                BorderThickness="2"
                                                CornerRadius="17">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tester.IsFaceSouthPressed}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ConnectedStatusBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       Text="A" />
                                        </Border>
                                        <Border Canvas.Left="307"
                                                Canvas.Top="94"
                                                Width="34"
                                                Height="34"
                                                BorderBrush="{DynamicResource SecondaryTextBrush}"
                                                BorderThickness="2"
                                                CornerRadius="17">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tester.IsFaceWestPressed}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ConnectedStatusBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       Text="X" />
                                        </Border>
                                        </Canvas>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Margin="0,0,0,12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"

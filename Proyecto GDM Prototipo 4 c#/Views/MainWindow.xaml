                                           Visibility="{Binding Tester.IsRawJoystick, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Margin="0,0,0,8"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding Tester.ControllerAnalysisText}" />
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding Tester.AxisListHeading}" />
                                <ItemsControl Margin="0,6,0,12"
                                              ItemsSource="{Binding Tester.InputSnapshot.Axes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,8,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Grid.Column="1"
                                                           FontFamily="Consolas"
                                                           Text="{Binding DisplayValue}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding Tester.ButtonListHeading}" />
                                <ItemsControl Margin="0,6,0,0"
                                              ItemsSource="{Binding Tester.InputSnapshot.Buttons}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,2,6,2"
                                                    Padding="6,4"
                                                    Background="{DynamicResource PanelRaisedBrush}"
                                                    CornerRadius="3">
                                                <TextBlock Text="{Binding Name}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource SecondaryTextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource ConnectedStatusBrush}" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Padding="20"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{Binding Tester.ShowNoSelectedDevice, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{Binding Tester.InputStatus}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Padding="24"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding ShowStatusCard, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="{Binding StatusTitle}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <DockPanel Margin="0,24,0,12"
                           LastChildFill="False"
                           Visibility="{Binding IsControllerSection, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock DockPanel.Dock="Left"
                                      VerticalAlignment="Center"
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      Text="Mandos conectados y guardados" />
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal">
                        <Button MinWidth="150"
                                Margin="0,0,8,0"
                                Padding="12,8"
                                Click="OpenWindowsGameControllers"
                                Content="Dispositivos de juego" />
                        <Button MinWidth="112"
                                Padding="16,8"
                                Command="{Binding RefreshDevicesCommand}"
                                Content="{Binding RefreshButtonText}" />
                    </StackPanel>
                </DockPanel>

                <TextBlock Margin="0,0,0,8"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="Al reconectar, GDM prioriza un número de serie único. Si SDL no lo proporciona, usa el nombre y VID/PID solo cuando hay una coincidencia única; mandos idénticos pueden no distinguirse."
                           TextWrapping="Wrap"
                           Visibility="{Binding IsControllerSection, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="No hay mandos conectados ni guardados. Comprueba la conexión y, si usas HidHide, permite GDM."
                           Visibility="{Binding ShowEmptyDevicesMessage, Converter={StaticResource BoolToVisibility}}" />

                <ItemsControl Margin="0,8,0,0"
                                     ItemsSource="{Binding ControllerItems}"
                                     Visibility="{Binding ShowConnectedGamepads, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                                   <Border Margin="0,0,0,10"
                                           Padding="18"
                                           Background="{DynamicResource PanelBrush}"
                                           BorderBrush="{DynamicResource BorderBrush}"
                                           BorderThickness="1"
                                           CornerRadius="8">
                                       <Grid>
                                           <Grid.ColumnDefinitions>
                                               <ColumnDefinition Width="*" />
                                               <ColumnDefinition Width="Auto" />
                                               <ColumnDefinition Width="Auto" />
                                           </Grid.ColumnDefinitions>
                                           <StackPanel>
                                               <TextBlock FontSize="16"
                                                          FontWeight="SemiBold"
                                                          Text="{Binding Name}" />
                                               <TextBlock Margin="0,6,0,0"
                                                          Foreground="{DynamicResource SecondaryTextBrush}"
                                                          Text="{Binding HardwareIdLabel}" />
                                               <TextBlock Margin="0,3,0,0"
                                                          FontSize="11"
                                                          Foreground="{DynamicResource SecondaryTextBrush}"
                                                          Text="{Binding DeviceKey}"
                                                          Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                                           </StackPanel>
                                           <TextBlock Grid.Column="1"
                                                      Margin="16,0,0,0"
                                                      VerticalAlignment="Center"
                                                      FontWeight="SemiBold"
                                                      Foreground="{DynamicResource ConnectedStatusBrush}"
                                                      Text="{Binding ConnectionText}" />
                                           <StackPanel Grid.Column="2"
                                                       Margin="16,0,0,0"
                                                       VerticalAlignment="Center">
                                               <Button MinWidth="90"
                                                       Padding="12,6"
                                                       Command="{Binding DataContext.SaveControllerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}"
                                                       Content="Guardar"
                                                       Visibility="{Binding CanSave, Converter={StaticResource BoolToVisibility}}" />
                                               <Button MinWidth="90"
                                                       Margin="0,6,0,0"
                                                       Padding="12,6"
                                                       Command="{Binding DataContext.RemoveSavedControllerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}"
                                                       Content="Eliminar"
                                                       Visibility="{Binding CanRemoveSaved, Converter={StaticResource BoolToVisibility}}" />
                                           </StackPanel>
                                       </Grid>
                                   </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="0,2,0,0"
                            Visibility="{Binding IsHidHideSection, Converter={StaticResource BoolToVisibility}}">
                    <Border Padding="20"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Estado de HidHide" />
                                <Button DockPanel.Dock="Right"
                                        MinWidth="100"
                                        Command="{Binding HidHide.RefreshCommand}"
                                        Content="Actualizar estado" />
                            </DockPanel>
                            <TextBlock Margin="0,8,0,0"
                                       FontWeight="SemiBold"
                                       Text="{Binding HidHide.DriverStatus}" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{Binding HidHide.StatusMessage}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,14,0,0"
                            Padding="20"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Mandos detectados" />
                            <TextBlock Margin="0,6,0,12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Oculta solo los mandos que SDL identifica por su ruta HID. GDM se añadirá a la lista permitida para poder continuar leyendo la entrada. Recomendado: inicia primero la salida virtual correspondiente."
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,0,0,8"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="No hay mandos detectados."
                                       Visibility="{Binding HidHide.ShowEmptyDevicesMessage, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding HidHide.Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="12"
                                                Background="{DynamicResource PanelRaisedBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding Name}" />
                                                    <TextBlock Margin="0,3,0,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               Text="{Binding HardwareIdLabel}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding StateText}" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        MinWidth="150"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding ToggleCommand}"
                                                        Content="{Binding ToggleButtonText}"
                                                        ToolTip="Agrega el mando a la lista negra de HidHide. Si sigue oculto al cerrar GDM depende de la opción «Mostrar los mandos ocultos al cerrar GDM» en Ajustes > Mandos."
                                                        IsEnabled="{Binding CanManage}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,14,0,0"
                            Padding="16"
                            Background="{DynamicResource PanelRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Protección: GDM agrega a la lista negra persistente solo los mandos que ocultas y restaura esas entradas al cerrar. Si GDM se cierra inesperadamente, las recupera al siguiente inicio. Las entradas negras preexistentes y el filtro global no se modifican. La ruta de GDM se agrega a la lista permitida de HidHide si hace falta."
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,2,0,0"
                            Visibility="{Binding IsSettingsSection, Converter={StaticResource BoolToVisibility}}">
                    <TabControl SelectedIndex="{Binding Settings.SelectedCategoryIndex, Mode=TwoWay}">
                        <TabItem Header="General" />
                        <TabItem Header="Interfaz" />
                        <TabItem Header="Mandos" />
                        <TabItem Header="Dependencias" />
                        <TabItem Header="Acerca de" />
                    </TabControl>
                    <Border Margin="0,12,0,0"
                            MinHeight="290"
                            Padding="24"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <StackPanel Visibility="{Binding Settings.IsGeneralCategory, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Inicio de GDM" />
                                <CheckBox Margin="0,18,0,0"
                                          Content="Abrir al iniciar Windows"
                                          IsChecked="{Binding Settings.StartWithWindows, Mode=TwoWay}" />
                                <CheckBox Margin="24,12,0,0"
                                          Content="Abrir minimizado en la bandeja"
                                          IsChecked="{Binding Settings.StartMinimized, Mode=TwoWay}"
                                          IsEnabled="{Binding Settings.StartWithWindows}" />
                                <CheckBox Margin="24,12,0,0"
                                          Content="Iniciar elevado mediante una tarea programada"
                                          IsChecked="{Binding Settings.StartWithWindowsAsTask, Mode=TwoWay}"
                                          IsEnabled="{Binding Settings.StartWithWindows}" />
                                <TextBlock Margin="44,6,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Windows solicitará autorización de administrador al activar, cambiar o quitar esta tarea. Después, iniciará GDM elevado al iniciar sesión sin mostrar UAC en cada inicio."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,14,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Al cerrar la ventana, GDM seguirá ejecutándose en segundo plano. Para salir completamente, usa Cerrar GDM desde el menú del icono de bandeja."
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding Settings.IsInterfaceCategory, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Apariencia" />
                                <TextBlock Margin="0,8,0,14"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Elige el tema visual de GDM." />
                                <ComboBox Width="220"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding Settings.ThemeOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Settings.SelectedTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,18,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="El idioma disponible actualmente es Español."
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding Settings.IsControllersCategory, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Configuración de mandos" />
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Guarda mandos desde la pestaña Mandos. Configura inicio automático, perfiles, remapeo y ocultamiento automático desde Perfiles."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,14,0,5"
                                           FontSize="12"
                                           Text="Tipo de mando virtual predeterminado" />
                                <ComboBox Width="220"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding Settings.VirtualGamepadTypeOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding Settings.DefaultVirtualGamepadType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Se usa en los mandos sin perfil asignado y en las salidas iniciadas desde Tester. Los perfiles guardados pueden definir su propio tipo."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,14,0,5"
                                           FontSize="12"
                                           Text="Perfil predeterminado para mandos nuevos" />
                                <ComboBox Width="220"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding Profiles.AssignmentChoices}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="ProfileId"
                                          SelectedValue="{Binding Settings.DefaultProfileId, Mode=TwoWay}" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Al guardar un mando nuevo se le asigna este perfil automáticamente. «Sin perfil» desactiva la asignación automática; la asignación manual desde Perfiles no cambia."
                                           TextWrapping="Wrap" />
                                <CheckBox Margin="0,18,0,0"
                                          Content="Mostrar los mandos ocultos al cerrar GDM"
                                          IsChecked="{Binding Settings.RestoreGamepadsOnExit, Mode=TwoWay}" />
                                <TextBlock Margin="24,6,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Si está activado, los mandos que GDM ocultó vuelven a mostrarse al cerrar GDM. Si está desactivado, permanecen en la lista negra de HidHide hasta que los muestres manualmente desde la pestaña HidHide."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,12,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="La vibración y la transferencia de sensores aún no están disponibles."
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding Settings.IsDependenciesCategory, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Dependencias" />
                                <TextBlock Margin="0,12,0,0"
                                           Text=".NET 10 Desktop Runtime x64 — requerido para ejecutar GDM." />
                                <TextBlock Margin="0,8,0,0"
                                           Text="SDL2 — incluido con GDM para detectar mandos y leer sus entradas." />
                                <TextBlock Margin="0,8,0,0"
                                           Text="HIDMaestro — incluido; instala su controlador al iniciar una salida virtual." />
                                <TextBlock Margin="0,8,0,0"
                                           Text="HidHide — controlador opcional, se instala por separado." />
                            </StackPanel>

                            <StackPanel Visibility="{Binding Settings.IsAboutCategory, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Gamepad Device Manager" />
                                <TextBlock Margin="0,12,0,0"
                                           Text="{Binding DataContext.VersionLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="{Binding DataContext.ProgressIdLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="{Binding DataContext.BuildTimestampLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <TextBlock Margin="0,14,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Aplicación portable para Windows."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Creado por LiebheartZ." />
                            </StackPanel>

                            <StackPanel Visibility="{Binding Settings.IsDebugCategory, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Depuración" />
                                <CheckBox Margin="0,14,0,0"
                                          Content="Mostrar mandos virtuales en todas las pestañas"
                                          IsChecked="{Binding Settings.ShowVirtualGamepadsInAllTabs, Mode=TwoWay}" />
                                <TextBlock Margin="24,6,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Por defecto los mandos virtuales de HIDMaestro solo aparecen en Mandos y Tester, marcados como «Mando virtual». Activa esta opción para verlos también en HidHide y el resto de listas de dispositivos."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Margin="0,16,0,0"
                                Orientation="Horizontal">
                        <Button MinWidth="130"
                                Padding="14,8"
                                Command="{Binding Settings.SaveCommand}"
                                Content="{Binding Settings.SaveButtonText}" />
                        <Button MinWidth="150"
                                Margin="10,0,0,0"
                                Padding="14,8"
                                Command="{Binding Settings.RestoreDefaultsCommand}"
                                Content="Restaurar predeterminados" />
                    </StackPanel>
                    <TextBlock Margin="0,16,0,0"
                               FontWeight="SemiBold"
                               Text="{Binding Settings.StatusTitle}" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding Settings.StatusMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,2,0,0"
                            Visibility="{Binding IsLogSection, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Margin="0,0,0,4"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Archivo de registro" />
                    <TextBlock Margin="0,0,0,10"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="{Binding LogFilePath}" />
                    <Border Padding="12"
                            Background="#111820"
                            BorderBrush="#293543"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ScrollViewer MaxHeight="390"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LogEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,7"
                                                BorderBrush="#293543"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="165" />
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="115" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="#AAB6C4"
                                                           Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                                <TextBlock Grid.Column="1"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Level}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#8CC8FF" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:DiagnosticLogLevel.Warning}">
                                                                    <Setter Property="Foreground" Value="#F3C969" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:DiagnosticLogLevel.Error}">
                                                                    <Setter Property="Foreground" Value="#FF8585" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:DiagnosticLogLevel.Critical}">
                                                                    <Setter Property="Foreground" Value="#FF4F64" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="#8CC8FF"
                                                           Text="{Binding Source}" />
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock FontFamily="Consolas"
                                                               FontSize="11"
                                                               Foreground="#E1E8EF"
                                                               Text="{Binding Message}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontFamily="Consolas"
                                                               FontSize="10"
                                                               Foreground="#AAB6C4"
                                                               Text="{Binding Details}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="Este registro contiene errores y eventos de ejecución. Los errores de compilación aparecen en la salida de compilación de VS Code." />
                </StackPanel>

                <StackPanel Visibility="{Binding IsProfilesSection, Converter={StaticResource BoolToVisibility}}">
                    <TabControl ItemsSource="{Binding Profiles.VirtualGamepads}"
                                SelectedItem="{Binding Profiles.SelectedVirtualGamepad, Mode=TwoWay}"
                                Background="Transparent"
                                BorderThickness="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Padding" Value="16,8" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="TabBorder"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{DynamicResource PanelBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1,1,1,0"
                                                    CornerRadius="6,6,0,0">
                                                <ContentPresenter ContentSource="Header"
                                                                  HorizontalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabBorder"
                                                            Property="Background"
                                                            Value="{DynamicResource PanelRaisedBrush}" />
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource PrimaryTextBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabBorder"
                                                            Property="BorderBrush"
                                                            Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding DisplayName}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="10"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{Binding ConnectionStatus}" />
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Margin="16,14,16,16">
                                    <Border Padding="14"
                                            Background="{DynamicResource PanelBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding DisplayName}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Text="{Binding ConnectionStatus}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Text="{Binding ProfileName, StringFormat=Perfil: {0}}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Text="{Binding VirtualGamepadTypeName, StringFormat=Tipo: {0}}" />
                                                <TextBlock Margin="0,5,0,0"
                                                           FontSize="11"
                                                           Text="{Binding StatusMessage}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <WrapPanel Grid.Column="1"
                                                       VerticalAlignment="Center">
                                                <Button MinWidth="90"
                                                        Margin="0,0,8,0"
                                                        Command="{Binding StartCommand}"
                                                        CommandParameter="{Binding}"
                                                        Content="Iniciar" />
                                                <Button MinWidth="90"
                                                        Margin="0,0,8,0"
                                                        Command="{Binding StopCommand}"
                                                        CommandParameter="{Binding}"
                                                        Content="Detener" />
                                                <ToggleButton Width="160"
                                                              MinHeight="52"
                                                              Padding="8,5"
                                                              IsChecked="{Binding AutoStartOnConnect, Mode=OneWay}"
                                                              Command="{Binding ToggleAutoStartCommand}"
                                                              CommandParameter="{Binding}"
                                                              ToolTip="Activa o desactiva el inicio automático de este mando">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="SwitchBorder"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Background="{DynamicResource ButtonBrush}"
                                                                    BorderBrush="{DynamicResource ButtonBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="5">
                                                                <StackPanel>
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      Content="Inicio automático"
                                                                                      TextElement.Foreground="{DynamicResource PrimaryTextBrush}" />
                                                                    <StackPanel Margin="0,5,0,0"
                                                                                HorizontalAlignment="Center"
                                                                                Orientation="Horizontal">
                                                                        <Grid Width="38"
                                                                              Height="20"
                                                                              VerticalAlignment="Center">
                                                                            <Border x:Name="SwitchTrack"
                                                                                    Background="{DynamicResource BorderBrush}"
                                                                                    CornerRadius="10" />
                                                                            <Ellipse x:Name="SwitchThumb"
                                                                                     Width="14"
                                                                                     Height="14"
                                                                                     Margin="3"
                                                                                     HorizontalAlignment="Left"
                                                                                     Fill="White" />
                                                                        </Grid>
                                                                        <TextBlock x:Name="SwitchState"
                                                                                   Margin="7,0,0,0"
                                                                                   VerticalAlignment="Center"
                                                                                   FontSize="11"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                                   Text="DESACTIVADO" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="SwitchTrack"
                                                                            Property="Background"
                                                                            Value="{DynamicResource ConnectedStatusBrush}" />
                                                                    <Setter TargetName="SwitchThumb"
                                                                            Property="HorizontalAlignment"
                                                                            Value="Right" />
                                                                    <Setter TargetName="SwitchState"
                                                                            Property="Foreground"
                                                                            Value="{DynamicResource ConnectedStatusBrush}" />
                                                                    <Setter TargetName="SwitchState"
                                                                            Property="Text"
                                                                            Value="ACTIVADO" />
                                                                    <Setter TargetName="SwitchBorder"
                                                                            Property="BorderBrush"
                                                                            Value="{DynamicResource ConnectedStatusBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="SwitchBorder"
                                                                            Property="BorderBrush"
                                                                            Value="{DynamicResource AccentBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter TargetName="SwitchBorder"
                                                                            Property="BorderBrush"
                                                                            Value="{DynamicResource AccentBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Opacity" Value="0.55" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                <CheckBox Margin="12,0,0,0"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding AutoHideOnConnect, Mode=OneWay}"
                                                          Command="{Binding ToggleAutoHideCommand}"
                                                          CommandParameter="{Binding}"
                                                          Content="Ocultar automáticamente"
                                                          ToolTip="Oculta el mando físico solo después de iniciar correctamente su mando virtual." />
                                                <CheckBox Margin="12,0,0,0"
                                                          VerticalAlignment="Center"
                                                          IsEnabled="{Binding AutoHideOnConnect}"
                                                          IsChecked="{Binding KeepHiddenOnExit, Mode=OneWay}"
                                                          Command="{Binding ToggleKeepHiddenOnExitCommand}"
                                                          CommandParameter="{Binding}"
                                                          Content="Mantener oculto al cerrar GDM"
                                                          ToolTip="Conserva este mando en la lista negra de HidHide al cerrar GDM. Seguirá oculto al volver a abrir GDM hasta que lo muestres desde la pestaña HidHide." />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                    <Border Margin="0,14,0,0"
                                            Padding="14"
                                            Background="{DynamicResource PanelBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Text="Perfil asignado" />
                                            <TextBlock Margin="0,5,0,12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Text="El perfil elegido se aplica a la salida virtual de este mando. «Sin perfil» elimina la asignación actual."
                                                       TextWrapping="Wrap" />
                                            <WrapPanel>
                                                <ComboBox MinWidth="220"
                                                          Margin="0,0,10,8"
                                                          Padding="6"
                                                          ItemsSource="{Binding DataContext.Profiles.AssignmentChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedItem="{Binding DataContext.Profiles.SelectedAssignmentProfile, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <Button MinWidth="130"
                                                        Margin="0,0,0,8"
                                                        Padding="12,7"
                                                        Command="{Binding DataContext.Profiles.AssignCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Content="Asignar perfil" />
                                            </WrapPanel>
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Text="{Binding DataContext.Profiles.StatusMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <views:ProfileEditorView Margin="0,16,0,0"
                                                             DataContext="{Binding DataContext.Profiles, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                    <Border Margin="0,16,0,0"
                            Padding="18"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding Profiles.ShowNoVirtualGamepads, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Sin mandos guardados" />
                            <TextBlock Margin="0,5,0,12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Guarda mandos desde la pestaña Mandos para aparecer como subpestañas aquí. Mientras tanto puedes crear y editar perfiles."
                                       TextWrapping="Wrap" />
                            <views:ProfileEditorView DataContext="{Binding Profiles, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

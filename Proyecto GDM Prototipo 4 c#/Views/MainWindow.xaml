<Window x:Class="GDM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:GDM.Models"
        Title="GDM — Gamepad Device Manager"
        Icon="/cover.ico"
        Width="800"
        Height="600"
        MinWidth="640"
        MinHeight="480"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#183E5C">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image Width="42"
                           Height="42"
                           Source="/cover.ico"
                           Stretch="Uniform" />
                    <TextBlock Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               Text="GDM" />
                    <TextBlock Margin="8,5,0,0"
                               VerticalAlignment="Center"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               Text="Gamepad Device Manager" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#C5D5E3"
                           Text="{Binding BuildLabel}" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#183E5C"
                BorderBrush="#2D5877"
                BorderThickness="0,0,0,1">
            <StackPanel Margin="24,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Stretch">
                <Button Command="{Binding NavigateCommand}"
                        CommandParameter="Inicio"
                        Content="Inicio"
                        Style="{StaticResource TopTabButtonStyle}"
                        Tag="Inicio" />
                <Button Command="{Binding NavigateCommand}"
                        CommandParameter="Mandos"
                        Content="Mandos"
                        Style="{StaticResource TopTabButtonStyle}"
                        Tag="Mandos" />
                <Button Command="{Binding NavigateCommand}"
                        CommandParameter="Ajustes"
                        Content="Ajustes"
                        Style="{StaticResource TopTabButtonStyle}"
                        Tag="Ajustes" />
                <Button Command="{Binding NavigateCommand}"
                        CommandParameter="Registro"
                        Content="Registro"
                        Style="{StaticResource TopTabButtonStyle}"
                        Tag="Registro" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2"
                      Background="{StaticResource WindowBrush}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="48,30" MaxWidth="900">
                <TextBlock FontSize="30"
                           FontWeight="SemiBold"
                           Text="{Binding SectionTitle}" />
                <TextBlock Margin="0,10,0,28"
                           FontSize="15"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{Binding SectionDescription}"
                           TextWrapping="Wrap" />

                <Border Padding="24"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="#D9E2EA"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding ShowStatusCard, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="{Binding StatusTitle}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <DockPanel Margin="0,24,0,12"
                           LastChildFill="False"
                           Visibility="{Binding IsControllerSection, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock DockPanel.Dock="Left"
                                      VerticalAlignment="Center"
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      Text="Mandos conectados" />
                    <Button DockPanel.Dock="Right"
                                   MinWidth="112"
                                   Padding="16,8"
                                   Command="{Binding RefreshDevicesCommand}"
                                   Content="{Binding RefreshButtonText}" />
                </DockPanel>

                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="SDL2 no ve mandos accesibles. Comprueba la conexión y, si usas HidHide, permite GDM."
                           Visibility="{Binding ShowEmptyDevicesMessage, Converter={StaticResource BoolToVisibility}}" />

                <ItemsControl Margin="0,8,0,0"
                                     ItemsSource="{Binding ConnectedGamepads}"
                                     Visibility="{Binding ShowConnectedGamepads, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                                   <Border Margin="0,0,0,10"
                                           Padding="18"
                                           Background="{StaticResource PanelBrush}"
                                           BorderBrush="#D9E2EA"
                                           BorderThickness="1"
                                           CornerRadius="8">
                                       <Grid>
                                           <Grid.ColumnDefinitions>
                                               <ColumnDefinition Width="*" />
                                               <ColumnDefinition Width="Auto" />
                                           </Grid.ColumnDefinitions>
                                           <StackPanel>
                                               <TextBlock FontSize="16"
                                                          FontWeight="SemiBold"
                                                          Text="{Binding Name}" />
                                               <TextBlock Margin="0,6,0,0"
                                                          Foreground="{StaticResource SecondaryTextBrush}"
                                                          Text="{Binding HardwareIdLabel}" />
                                               <TextBlock Margin="0,3,0,0"
                                                          FontSize="11"
                                                          Foreground="{StaticResource SecondaryTextBrush}"
                                                          Text="{Binding DeviceKey}" />
                                           </StackPanel>
                                           <TextBlock Grid.Column="1"
                                                      Margin="16,0,0,0"
                                                      VerticalAlignment="Center"
                                                      FontWeight="SemiBold"
                                                      Foreground="#177A56"
                                                      Text="Conectado" />
                                       </Grid>
                                   </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="0,2,0,0"
                            Visibility="{Binding IsLogSection, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Margin="0,0,0,4"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="Archivo de registro" />
                    <TextBlock Margin="0,0,0,10"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding LogFilePath}" />
                    <Border Padding="12"
                            Background="#111820"
                            BorderBrush="#293543"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ScrollViewer MaxHeight="390"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LogEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,7"
                                                BorderBrush="#293543"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="165" />
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="115" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="#AAB6C4"
                                                           Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                                <TextBlock Grid.Column="1"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Level}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#8CC8FF" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:DiagnosticLogLevel.Warning}">
                                                                    <Setter Property="Foreground" Value="#F3C969" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:DiagnosticLogLevel.Error}">
                                                                    <Setter Property="Foreground" Value="#FF8585" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static models:DiagnosticLogLevel.Critical}">
                                                                    <Setter Property="Foreground" Value="#FF4F64" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="#8CC8FF"
                                                           Text="{Binding Source}" />
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock FontFamily="Consolas"
                                                               FontSize="11"
                                                               Foreground="#E1E8EF"
                                                               Text="{Binding Message}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontFamily="Consolas"
                                                               FontSize="10"
                                                               Foreground="#AAB6C4"
                                                               Text="{Binding Details}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="Este registro contiene errores y eventos de ejecución. Los errores de compilación aparecen en la salida de compilación de VS Code." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
